{
  "name": "dsh-api-dashboard",
  "version": "1.7.2",
  "description": "DeepSeek Harness 多平台 API 余额 / 用量看板：输入框下方实时显示各平台余额与本会话估算消耗",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "dashboard",
    "api-balance"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "docs/PRICING-20261010.md",
    "docs/MARKETPLACE.md",
    "docs/交接-2026-11-11-官方账号登录余额.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/133563825as-ai/dsh-api-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/133563825as-ai/dsh-api-dashboard/issues"
  },
  "homepage": "https://github.com/133563825as-ai/dsh-api-dashboard#readme",
  "dsh": {
    "update": {
      "summary": "1.7.4：官方登录（非 API Key）也能读 DeepSeek 余额；智谱 Coding Plan 只有百分比时按最紧窗口剩余%显示并列出各窗口已用%（issue #4）。状态条落点不变。",
      "targets": [
        "DSH / DSHA Web（0.1.x 与 0.2.x 声明范围）",
        "手机、平板、桌面"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.1.7-rc.2": "unknown",
        "0.2.0": "unknown",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "semver": "^7.8.5",
    "@deepseek-ai/dsh": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "semver": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "license": "MIT"
}
